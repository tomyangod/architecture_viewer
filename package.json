{
  "name": "arch-viewer",
  "displayName": "Architecture Viewer",
  "description": "从仓库生成 C4 六视图架构图：CLI + 自托管 Web，扫描、生成、漂移校验一站式。",
  "version": "0.7.0",
  "publisher": "heyangyan",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "categories": [
    "Visualization",
    "Developer Tools"
  ],
  "keywords": [
    "architecture",
    "c4",
    "mermaid",
    "diagram",
    "code-to-diagram",
    "drift-detection"
  ],
  "files": [
    "bin/",
    "lib/",
    "web/",
    "vendor/",
    "architecture_visualized.html",
    "architecture.config.js",
    "AGENT.md",
    "USER_GUIDE.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.en.md"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "bin": {
    "arch-viewer": "bin/arch-viewer.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "architectureViewer.init",
        "title": "Architecture Viewer: Init Kit"
      },
      {
        "command": "architectureViewer.generate",
        "title": "Architecture Viewer: Generate"
      },
      {
        "command": "architectureViewer.preview",
        "title": "Architecture Viewer: Preview"
      },
      {
        "command": "architectureViewer.validate",
        "title": "Architecture Viewer: Validate"
      },
      {
        "command": "architectureViewer.copyAgentPrompt",
        "title": "Architecture Viewer: Copy Cursor Agent Prompt"
      },
      {
        "command": "architectureViewer.sessionStart",
        "title": "Architecture Viewer: Session Start（记录架构基线）"
      },
      {
        "command": "architectureViewer.sessionReport",
        "title": "Architecture Viewer: Session Report（查看架构变更报告）"
      },
      {
        "command": "architectureViewer.sessionRefresh",
        "title": "Architecture Viewer: Session Refresh（立即重新分析）"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "architectureViewer.sessionStart",
          "category": "Architecture Viewer"
        },
        {
          "command": "architectureViewer.sessionReport",
          "category": "Architecture Viewer"
        },
        {
          "command": "architectureViewer.sessionRefresh",
          "category": "Architecture Viewer"
        }
      ]
    },
    "configuration": {
      "title": "Architecture Viewer",
      "properties": {
        "architectureViewer.outputDir": {
          "type": "string",
          "default": "architecture_viewer",
          "description": "Init/Generate 写入目标仓库的相对目录"
        },
        "architectureViewer.session.enabled": {
          "type": "boolean",
          "default": true,
          "description": "会话模式：代码变更后自动分析架构变化并显示状态栏角标"
        },
        "architectureViewer.session.debounceSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 2,
          "description": "代码停止变更多少秒后触发架构分析（防抖等待，避免 AI 连续写入时频繁重算）"
        },
        "architectureViewer.session.analyzeOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "打开工作区且已有基线时，启动后自动分析一次以刷新角标"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "node lib/cli.js check .",
    "arch:baseline": "node lib/cli.js session start .",
    "arch:report": "node lib/cli.js session report . --open",
    "arch:report:text": "node lib/cli.js session report .",
    "demo": "bash scripts/demo.sh",
    "eval": "node lib/cli.js eval",
    "web": "node web/server.js",
    "start": "node web/server.js",
    "bake:samples": "node scripts/bake-samples.js",
    "wbs": "node pm/scripts/wbs.mjs",
    "prepublishOnly": "node --check lib/cli.js && node --check lib/index.js && node --check web/server.js && node --test test/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/heyangyan/architecture_viewer.git"
  },
  "dependencies": {
    "tree-sitter": "^0.25.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  }
}
