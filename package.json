{
  "name": "arch-viewer",
  "displayName": "Architecture Viewer",
  "description": "AI 写完代码后，自动看清架构变了什么：会话基线 → 变更图谱 → 影响面分析，IDE 状态栏 / PR 评论 / CLI 三端可用。",
  "version": "0.12.2-rc.7",
  "publisher": "heyangyan",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "engines": {
    "node": ">=18",
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Developer Tools"
  ],
  "keywords": [
    "architecture",
    "ai-coding",
    "code-review",
    "impact-analysis",
    "c4",
    "mermaid",
    "diagram",
    "drift-detection",
    "pull-request",
    "mcp",
    "model-context-protocol",
    "layer-violation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "telemetry": {
    "enabled": false
  },
  "main": "./src/extension.js",
  "bin": {
    "arch-viewer": "bin/arch-viewer.js",
    "arch-viewer-mcp": "mcp/server.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "architectureViewer.init",
        "title": "Architecture Viewer: Init Kit"
      },
      {
        "command": "architectureViewer.generate",
        "title": "Architecture Viewer: Generate"
      },
      {
        "command": "architectureViewer.preview",
        "title": "Architecture Viewer: Preview"
      },
      {
        "command": "architectureViewer.validate",
        "title": "Architecture Viewer: Validate"
      },
      {
        "command": "architectureViewer.copyAgentPrompt",
        "title": "Architecture Viewer: Copy Cursor Agent Prompt"
      },
      {
        "command": "architectureViewer.sessionStart",
        "title": "Architecture Viewer: Session Start（记录架构基线）"
      },
      {
        "command": "architectureViewer.sessionReport",
        "title": "Architecture Viewer: Session Report（查看架构变更报告）"
      },
      {
        "command": "architectureViewer.sessionRefresh",
        "title": "Architecture Viewer: Session Refresh（立即重新分析）"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "architectureViewer.sessionStart",
          "category": "Architecture Viewer"
        },
        {
          "command": "architectureViewer.sessionReport",
          "category": "Architecture Viewer"
        },
        {
          "command": "architectureViewer.sessionRefresh",
          "category": "Architecture Viewer"
        }
      ]
    },
    "configuration": {
      "title": "Architecture Viewer",
      "properties": {
        "architectureViewer.outputDir": {
          "type": "string",
          "default": "architecture_viewer",
          "description": "Init/Generate 写入目标仓库的相对目录"
        },
        "architectureViewer.session.enabled": {
          "type": "boolean",
          "default": true,
          "description": "会话模式：代码变更后自动分析架构变化并显示状态栏角标"
        },
        "architectureViewer.session.debounceSeconds": {
          "type": "number",
          "default": 8,
          "minimum": 2,
          "description": "代码停止变更多少秒后触发架构分析（防抖等待，避免 AI 连续写入时频繁重算；MCP 默认同为 8，可用 .av/session.json 覆盖）"
        },
        "architectureViewer.session.analyzeOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "打开工作区且已有基线时，启动后自动分析一次以刷新角标"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "node lib/cli.js check .",
    "arch:baseline": "node lib/cli.js session start .",
    "arch:report": "node lib/cli.js session report . --open",
    "arch:report:text": "node lib/cli.js session report .",
    "mcp": "node mcp/server.js",
    "demo": "bash scripts/demo.sh",
    "demo:beginner": "AV_DEMO_NOPAUSE=1 bash scripts/beginner-demo.sh",
    "demo:beginner:step": "bash scripts/beginner-demo.sh",
    "eval": "node lib/cli.js eval",
    "web": "node web/server.js",
    "start": "node web/server.js",
    "bake:samples": "node scripts/bake-samples.js",
    "wbs": "node pm/scripts/wbs.mjs",
    "metrics:pull": "node pm/scripts/metrics-pull.mjs",
    "pack:npm": "npm pack --dry-run",
    "release:npm": "npm publish --access public",
    "build:vsix": "node scripts/build-vsix.js",
    "publish:vsix": "node scripts/build-vsix.js && vsce publish --packagePath arch-viewer.vsix --no-git-tag-version",
    "publish:ovsx": "ovsx publish arch-viewer.vsix",
    "prepublishOnly": "node --check lib/cli.js && node --check lib/index.js && node --check web/server.js && node --test test/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vscode/vsce": "^3.9.2"
  },
  "homepage": "https://gitee.com/heyangyan/architecture_viewer",
  "bugs": {
    "url": "https://gitee.com/heyangyan/architecture_viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/heyangyan/architecture_viewer.git"
  },
  "dependencies": {
    "tree-sitter": "^0.25.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "overrides": {
    "tree-sitter": "$tree-sitter"
  },
  "files": [
    "bin/",
    "lib/",
    "mcp/",
    "web/",
    "src/",
    "assets/",
    "vendor/",
    "templates/",
    "docs/delivery-scope.md",
    "docs/guides/welcome.html",
    "docs/welcome.html",
    ".cursor/rules/architecture-viewer.mdc",
    "architecture_visualized.html",
    "architecture.config.js",
    "AGENT.md",
    "USER_GUIDE.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.en.md",
    "architecture-rules.example.yaml",
    "c4-context.md",
    "c4-container.md",
    "c4-component.md",
    "block-diagram.md",
    "class-diagram.md",
    "deployment-ops.md",
    "scripts/ci-drift-action.mjs"
  ]
}
