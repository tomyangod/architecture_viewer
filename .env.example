# Architecture Viewer 环境变量示例
# 复制为 .env 后由进程管理器注入（Docker Compose 用 environment:）

PORT=3847
HOST=0.0.0.0

# 对外访问根 URL（Webhook / Stripe 回跳）
ARCH_PUBLIC_URL=https://arch.example.com

# Pro 必填（生产）：会话与仓库 PAT 加密
ARCH_PRO_SECRET=replace-with-long-random-string

# 管理员开通 / 签发许可证
ARCH_PRO_ADMIN_TOKEN=replace-with-admin-token
ARCH_PRO_LICENSE_SECRET=replace-with-license-hmac-secret

# 可选 Stripe（¥29/月 Price）
# ARCH_STRIPE_SECRET_KEY=sk_live_...
# ARCH_STRIPE_PRICE_ID=price_...
# ARCH_STRIPE_WEBHOOK_SECRET=whsec_...

# 公开收款链接（落地页定价区 / 控制台；先收款再人工开通，见 docs/billing.md）
# ARCH_PAY_AFDIAN_URL=https://afdian.com/a/your-creator
# ARCH_PAY_WECHAT_URL=https://your.site/pay-wechat.html
# ARCH_PAY_LEMON_URL=https://your-store.lemonsqueezy.com/checkout/buy/...

# 本机/内网本地文件夹检查（共享公网云请设 0）
# ARCH_PRO_LOCAL=1
# ARCH_PRO_LOCAL_ROOT=/Users/you/projects

# HTTPS 站点打开 Secure Cookie
# ARCH_COOKIE_SECURE=1

# 可选精修
# DEEPSEEK_API_KEY=sk-...
