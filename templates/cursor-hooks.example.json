{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/av-session-start.js",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/av-stop.js",
        "timeout": 120,
        "loop_limit": 1
      }
    ]
  }
}
